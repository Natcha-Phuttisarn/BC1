Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:includes|database|vendor|tests|tools|\.backups|\.git|\.agents|\.codex|\.aws)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "(?i)(\.(sql|log|bak|ini|md|lock|env|zip|tar|gz)$|^composer\.json$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
